 if(path==='admin'&&method==='GET'){if(!a.admin)fail_('승인된 관리자만 볼 수 있습니다.');const ids=[...new Set(rows_('상담기록').map(r=>r.v[0]).concat(rows_('작업자신청').map(r=>r.v[1])))];return ids.map(chat_).sort((x,y)=>y.updated.localeCompare(x.updated));}
